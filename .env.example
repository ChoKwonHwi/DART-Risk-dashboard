# DART OpenAPI: https://opendart.fss.or.kr 에서 발급
DART_API_KEY=

# OpenRouter: https://openrouter.ai/keys 에서 발급
OPENROUTER_API_KEY=
# 모델 이력: qwen3-235b-a22b는 OpenRouter 라우팅에 따라 응답이 특정 토큰을 무한 반복하는
# 디제너레이션 버그가 관측되어 deepseek-chat으로 교체했고, 이후 무료 모델들을 같은 입력으로
# 비교해 아래 모델을 기본값으로 사용한다 (비교 결과는 README "LLM 모델 선택" 참고).
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# 백엔드가 바라볼 FastAPI 주소 (Streamlit에서 사용)
BACKEND_URL=http://localhost:8000

# 네이버 뉴스 검색 API: https://developers.naver.com/apps 에서 애플리케이션 등록 후 발급
# (등록 시 "검색" API 사용 설정 필요)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
